# ==============================================================================
# EthioJobs Portal - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your environment-specific credentials and secrets.
# 3. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# In production, set DEBUG=False. Set to True only for local development.
DEBUG=True

# Secret key for cryptographic signing. Generate a strong unique key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Primary Database Connection
# SQLite default: sqlite:///db.sqlite3
# PostgreSQL example: postgres://user:password@localhost:5432/django_jobs_db
# MySQL example: mysql://user:password@localhost:3306/django_jobs_db
DATABASE_URL=sqlite:///db.sqlite3

# Optional: Disable SSL redirect during local development
RUNNING_LOCAL=true

# ------------------------------------------------------------------------------
# Social Authentication (OAuth2)
# ------------------------------------------------------------------------------
# Google OAuth2 credentials (from Google Cloud Console -> APIs & Services -> Credentials)
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# GitHub OAuth App credentials (from GitHub -> Settings -> Developer settings -> OAuth Apps)
SOCIAL_AUTH_GITHUB_KEY=
SOCIAL_AUTH_GITHUB_SECRET=

# LinkedIn OAuth credentials (optional)
SOCIAL_AUTH_LINKEDIN_OAUTH2_KEY=
SOCIAL_AUTH_LINKEDIN_OAUTH2_SECRET=

# Facebook OAuth credentials (optional)
SOCIAL_AUTH_FACEBOOK_KEY=
SOCIAL_AUTH_FACEBOOK_SECRET=

# ------------------------------------------------------------------------------
# Ethiopian Payment Gateway (Chapa)
# ------------------------------------------------------------------------------
# Test or Live secret key from https://dashboard.chapa.co
CHAPA_SECRET_KEY=CHASECK_TEST-sample-key

# ------------------------------------------------------------------------------
# Google Gemini 1.5 Flash Vision AI (License Verification Forensics)
# ------------------------------------------------------------------------------
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Telegram Mini-App & Broadcast Bot
# ------------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram Channel/Group ID for vacancy broadcasts (e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# SMTP Email Server Configuration
# ------------------------------------------------------------------------------
# Leave empty to log outgoing emails to console in development
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EthioJobPortal <noreply@ethiojobportal.com>

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Optional for production media assets)
# ------------------------------------------------------------------------------
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ------------------------------------------------------------------------------
# Monitoring & Metrics
# ------------------------------------------------------------------------------
ENABLE_PROMETHEUS=0
